# Copy these into your hosting provider's environment settings (never commit real values).

# Supabase: Project Settings > API Keys (publishable key) and the project URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI provider. "gemini" (free tier, for building and testing) or "anthropic" (paid).
AI_PROVIDER=gemini

# Gemini: free key from Google AI Studio (aistudio.google.com).
# On the free tier Google may use content to improve its products, so use it
# for testing only, not for real customers' private details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the first model is busy (comma separated, optional).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Claude: paid key from the Anthropic Console (used once Bilva has clients).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# How many successful AI runs one person can make in 24 hours (default 10).
AI_DAILY_LIMIT=10
